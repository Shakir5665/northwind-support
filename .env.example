# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend Configuration -------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section".
# When running on host: Server=localhost,1433
# When running in Docker Compose: Server=sqlserver,1433 (automatically resolved by Compose service name)
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, automatic EF migrations and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- JWT Authentication -----------------------------------------------------
# Symmetric key used to sign and validate JWT tokens. Must be at least 32 characters (256 bits).
# For production, generate a cryptographically strong random secret.
Jwt__SigningKey=local-development-secret-key-at-least-32-chars-long!
Jwt__Issuer=SupportDesk
Jwt__Audience=SupportDeskClient
Jwt__LifetimeMinutes=30

# --- Frontend / Web Client -------------------------------------------------
# By default Vite dev server proxies to https://localhost:7043 (host .NET profile).
# To point the Vite dev server to the containerised API on port 5080:
# VITE_API_PROXY_TARGET=http://localhost:5080
VITE_API_PROXY_TARGET=http://localhost:5080
